# ============================================================
# Simulador Mates — variables de entorno
# Copiar este archivo a .env.local y completar los valores.
# ============================================================

# --- Obligatorias (posición 1: esqueleto de Auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY

# Cliente de servicio: SOLO server-side (price config, webhooks, tickets 402).
# Nunca usarlo en código cliente ni exponerlo al browser.
# Esta nueva Secret key es el reemplazo directo y cumple exactamente la misma función administrativa que la service_role
SUPABASE_SERVICE_ROLE_KEY=TU-SERVICE-ROLE-KEY

# --- Posición 10 — pagos (spec_pagos.md): completar con las credenciales MP ---
# Access token de la app de Mercado Pago (sandbox para QA dev; producción al deployar).
MP_ACCESS_TOKEN=
# Public key del mismo app de MP (Checkout Pro).
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Secreto del webhook /api/webhooks/mercadopago para la firma HMAC x-signature (R7).
MP_WEBHOOK_SECRET=
# Origin público donde MP envía el webhook en QA dev (URL del túnel ngrok/Cloudflare
# apuntando al dev server). Sin la var, el webhook usa el origin del request
# (suficiente con dominio propio en producción).
MP_PUBLIC_ORIGIN=

# --- DEV ONLY: bypass de login/registro ---
# 1 = /editor abre sin sesión (plan PRO de prueba, autosave solo en localStorage);
# /auth y /perfil redirigen al editor. Vacío/comentado = auth normal.
# NUNCA usar en producción.
DEV_AUTH_BYPASS=

# --- Emails transaccionales (recibo de cobro / aviso de gracia / cierre programado, R10) ---
# https://resend.com — API key de la cuenta (o log honesto si falta).
RESEND_API_KEY=
# Remitente VERIFICADO en Resend (o dominio con SPF/DKIM al deployar).
EMAIL_FROM=Taller Mates <no-reply@tu-dominio.ar>

# --- Soporte de pagos (posición 11: "Verifico de nuevo" + SLA 24 h) ---
# Se muestran en /perfil después de 2 verificaciones sin pago. El email puede
# ser una casilla real o un alias; el WhatsApp, formato internacional sin "+".
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# --- Posición 12 — páginas legales y derechos del consumidor ---
# Identidad del proveedor (R13.1/R13.14). Si falta un dato, la página lo declara
# visiblemente antes del go-live; NUNCA se inventan razón social, CUIT ni domicilio.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_LEGAL_NAME=
LEGAL_ENTITY_CUIT=
LEGAL_ENTITY_TAX_CONDITION=
LEGAL_ENTITY_ADDRESS=
# Canal de atención obligatorio en producción (formularios, reclamos y alertas internas).
LEGAL_EMAIL=
LEGAL_PHONE=
# WhatsApp en formato internacional sin "+" (ej. 5491123456789).
LEGAL_WHATSAPP=
# Horario de atención electrónica: mínimo 8 h/día hábil (Disposición 954/2025 art. 6).
LEGAL_HOURS=
# Salt server-side para hashear IPs del rate limit (no guarda la IP cruda). Recomendado en producción.
LEGAL_IP_SALT=
# URL pública canónica: canonical de las páginas y links absolutos de los emails legales.
NEXT_PUBLIC_SITE_URL=
