# ============================================================
# Simulador Mates — variables de entorno
# Copiar este archivo a .env.local y completar los valores.
# ============================================================

# --- Obligatorias (posición 1: esqueleto de Auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY

# Cliente de servicio: SOLO server-side (price config, webhooks, tickets 402).
# Nunca usarlo en código cliente ni exponerlo al browser.
# Esta nueva Secret key es el reemplazo directo y cumple exactamente la misma función administrativa que la service_role
SUPABASE_SERVICE_ROLE_KEY=TU-SERVICE-ROLE-KEY

# --- Llegan en posiciones 8-10 (pagos/protección): descomentar cuando se implementen ---
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# RESEND_API_KEY=
